rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user can only read and write their own tracker data.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Collectr share snapshots: anyone with the (unguessable) link can read one,
    // nobody can list them, only the signed-in owner can create or delete them,
    // and nobody can edit them after creation.
    match /shares/{shareId} {
      allow get: if true;
      allow list, update: if false;
      allow create: if request.auth != null
        && shareId.size() == 20
        && request.resource.data.keys().hasOnly(['ownerUid', 'createdAt', 'payload'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.payload is string
        && request.resource.data.payload.size() < 900000;
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }

    // Cards a recipient found on a share link. Anyone with the link can send or replace
    // their own report; only the share owner can read or delete reports.
    match /shareFinds/{findId} {
      function validFind() {
        let data = request.resource.data;
        let sharePath = /databases/$(database)/documents/shares/$(data.shareId);
        return findId.size() == 20
          && data.keys().hasOnly(['shareId', 'ownerUid', 'name', 'cards', 'updatedAt'])
          && data.keys().hasAll(['shareId', 'ownerUid', 'name', 'cards', 'updatedAt'])
          && data.shareId is string && data.shareId.size() == 20
          && exists(sharePath)
          && data.ownerUid == get(sharePath).data.ownerUid
          && data.name is string && data.name.size() <= 40
          && data.cards is list && data.cards.size() > 0 && data.cards.size() <= 25000
          && data.updatedAt == request.time;
      }
      allow create: if validFind();
      allow update: if validFind() && request.resource.data.shareId == resource.data.shareId;
      allow get, list, delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }
  }
}
